APP_ENV=dev                          # local | dev | test | staging | prod
BUILD_VERSION=dev

HEALTH_PORT=8082

OTEL_SERVICE_NAME=workflow-events-consumer
OTEL_EXPORTER_OTLP_ENDPOINT=none     # collector address, or none to disable export
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_RATIO=1.0

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

CONSUMER_CONCURRENCY=10
VISIBILITY_TIMEOUT=30s
DRAIN_TIMEOUT=30s
FORWARD_TIMEOUT=5s
# HANDLER_TIMEOUT must not exceed VISIBILITY_TIMEOUT, and FORWARD_TIMEOUT must not exceed HANDLER_TIMEOUT.
HANDLER_TIMEOUT=20s
RETRY_BACKOFF_BASE=5s
RETRY_BACKOFF_MAX=5m
QUEUE_DEPTH_INTERVAL=30s

# Queues, downstream targets, and event routing all live in one file — see
# config/topology.example.yaml. Copy it to config/topology.yaml and fill in
# real queue URLs / target addresses; only the tokens below stay here.
TOPOLOGY_CONFIG_PATH=config/topology.yaml

EXECUTION_SERVICE_TOKEN=
DEFINITION_SERVICE_TOKEN=
WORKFLOW_STREAM_GATEWAY_TOKEN=
